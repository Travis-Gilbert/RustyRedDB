{
  "name": "@rustyreddb/node",
  "version": "0.1.0-beta.2",
  "description": "Embedded Rusty Red for Node.js and Bun: a native .rr graph file with full-text search.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Travis-Gilbert/RustyRedDB.git",
    "directory": "crates/rustyred-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "napi": {
    "binaryName": "rustyred",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ],
    "constEnum": false
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9"
  },
  "optionalDependencies": {
    "@rustyreddb/node-darwin-arm64": "0.1.0-beta.2",
    "@rustyreddb/node-linux-x64-gnu": "0.1.0-beta.2"
  }
}
