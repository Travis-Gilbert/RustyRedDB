#!/usr/bin/env python3
"""Prepare review artifacts; never publishes, creates tags, or moves live data."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=Path, required=True, help='New directory outside this checkout')
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
output = args.output.resolve()
if output.is_relative_to(root):
    raise SystemExit('Artifact output must be outside the checkout')
if subprocess.check_output(['git', 'status', '--porcelain'], cwd=root):
    raise SystemExit('Release artifacts require a clean committed candidate; use package_rehearsal.py --allow-dirty for development evidence')
source_revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()
if not shutil.which('cargo-about'):
    raise SystemExit('Install the notice generator first: cargo install --locked --version 0.9.2 --features cli cargo-about')
notice_tool = subprocess.check_output(['cargo', 'about', '--version'], cwd=root, text=True).strip()
if '0.9.2' not in notice_tool:
    raise SystemExit('Release notice generation is pinned to cargo-about 0.9.2')
output.mkdir(parents=True, exist_ok=False)
os.environ['TS_RS_EXPORT_DIR'] = str(output / 'generated-bindings')
# Existing integration oracles inspect process-global counters. Preserve their
# assertions while preventing unrelated tests from mutating those counters.
os.environ['RUST_TEST_THREADS'] = '1'

def run(*command):
    print('+ ' + ' '.join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=root, check=True)

run('python3', 'scripts/test_dependency_boundary.py')
run('python3', 'scripts/dependency_boundary.py')
run('python3', 'scripts/package_rehearsal.py', '--output', output / 'package-evidence')
run('cargo', 'about', 'generate', '--locked', '--offline', '--workspace', '--all-features', '--fail', 'about.hbs', '--output-file', output / 'THIRD_PARTY_LICENSES.html')
notice_path = output / 'THIRD_PARTY_LICENSES.html'
notice_text = notice_path.read_text()
notice_path.write_text('\n'.join(line.rstrip(' \t') for line in notice_text.split('\n')).rstrip('\n') + '\n')
run('cargo', '+1.96.1', 'test', '--locked', '--no-fail-fast', '--workspace', '--exclude', 'rustyred-engine', '--exclude', 'rustyred-graphblas', '--exclude', 'rustyred-egg', '--exclude', 'rustyred-turbovec', '--features', 'rustyred/test-fault-injection')
# Retained egg tests write relative target/*.dot even with an external Cargo target.
(root / 'vendor/egg-0.10.0/target').mkdir(exist_ok=True)
run('cargo', '+1.96.1', 'test', '--locked', '--no-fail-fast', '-p', 'rustyred-egg', '-p', 'rustyred-turbovec')
run('cargo', '+1.96.1', 'test', '--locked', '--no-fail-fast', '-p', 'rustyred-engine', '--lib', '--features', 'test-fault-injection')
run('cargo', '+1.96.1', 'test', '--locked', '--no-fail-fast', '-p', 'rustyred-engine', '--profile', 'dev', '--test', '*', '--features', 'test-fault-injection')
run('cargo', '+1.96.1', 'test', '--locked', '--doc', '-p', 'rustyred-engine')
run('cargo', '+1.96.1', 'clippy', '--locked', '-p', 'rustyred', '-p', 'rustyred-cli', '-p', 'rustyred-engine', '-p', 'rustyred-query', '--all-targets')
run('cargo', '+1.96.1', 'build', '--locked', '--release', '-p', 'rustyred-cli')
if subprocess.check_output(['git', 'status', '--porcelain'], cwd=root):
    raise SystemExit('Release checks modified source; review generated files before preparing artifacts')
revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()
if revision != source_revision:
    raise SystemExit('Source revision changed during release checks; refusing mixed candidate artifacts')
run('git', 'archive', '--format=tar.gz', '--prefix=rustyred-' + revision + '/', '--output=' + str(output / ('rustyred-source-' + revision + '.tar.gz')), revision)
target = Path(os.environ.get('CARGO_TARGET_DIR', str(root / 'target')))
shutil.copy2(target / 'release/rustyred', output / 'rustyred')
shutil.copytree(output / 'package-evidence/archives', output / 'crates')
provenance = {'revision': revision, 'source_revision_at_start': source_revision, 'dirty': False, 'rust_test_threads': '1', 'engine_test_profiles': {'unit': 'test/root1', 'integration': 'dev/root0/dependencies2'}, 'rustc': subprocess.check_output(['rustc', '+1.96.1', '-Vv'], cwd=root, text=True),
              'cargo': subprocess.check_output(['cargo', '+1.96.1', '-V'], cwd=root, text=True),
              'publication': 'disabled; review artifacts only', 'notice_generator': notice_tool, 'format': {'magic': 'THEORRDB', 'version': 1, 'header_bytes': 4096}}
(output / 'provenance.json').write_text(json.dumps(provenance, indent=2) + '\n')
files = [output / 'rustyred', output / 'provenance.json', output / 'THIRD_PARTY_LICENSES.html', *output.glob('*.tar.gz'), *sorted((output / 'crates').glob('*.crate'))]
(output / 'SHA256SUMS').write_text(''.join(hashlib.sha256(path.read_bytes()).hexdigest() + '  ' + str(path.relative_to(output)) + '\n' for path in files))
print('Artifacts prepared for review. Publication remains a separate authorized operation.')
